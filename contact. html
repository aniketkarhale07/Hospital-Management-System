<section class="bg-gradient-to-r from-blue-600 to-cyan-500 text-white py-16 text-center">
<h1 class="text-4xl font-bold">Contact Us</h1>
<p class="mt-3">We're here to help you</p>
</section>

<main class="max-w-6xl mx-auto px-6 py-12">

<div class="grid md:grid-cols-2 gap-10">

<div class="space-y-5">

<div class="bg-white shadow rounded-2xl p-6">
<div class="text-3xl">📍</div>
<h3 class="font-bold text-xl mt-3">Address</h3>
<p class="text-gray-500">123 Healthcare Street, Pune, Maharashtra</p>
</div>

<div class="bg-white shadow rounded-2xl p-6">
<div class="text-3xl">📞</div>
<h3 class="font-bold text-xl mt-3">Phone</h3>
<p class="text-gray-500">+91 98765 43210</p>
</div>

<div class="bg-white shadow rounded-2xl p-6">
<div class="text-3xl">✉️</div>
<h3 class="font-bold text-xl mt-3">Email</h3>
<p class="text-gray-500">info@medicare.com</p>
</div>

</div>

<div class="bg-white shadow-lg rounded-2xl p-8">

<h2 class="text-2xl font-bold mb-6">Send us a Message</h2>

<form class="space-y-5">

<input type="text" placeholder="Your Name"
class="w-full border rounded-xl px-4 py-3">

<input type="email" placeholder="Your Email"
class="w-full border rounded-xl px-4 py-3">

<input type="text" placeholder="Subject"
class="w-full border rounded-xl px-4 py-3">

<textarea rows="5" placeholder="Your Message"
class="w-full border rounded-xl px-4 py-3"></textarea>

<button class="w-full bg-blue-600 text-white py-3 rounded-xl font-bold hover:bg-blue-700">
Send Message
</button>

</form>

</div>

</div>
</main>

<footer class="bg-slate-900 text-white text-center py-6">
© 2026 MediCare Hospital
</footer>

</body>
</html>
